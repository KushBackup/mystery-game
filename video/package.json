{
  "name": "video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.503",
    "@remotion/google-fonts": "4.0.503",
    "@remotion/install-whisper-cpp": "4.0.503",
    "@remotion/shapes": "4.0.503",
    "@remotion/transitions": "4.0.503",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.503"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.503",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "promo:audio": "node scripts/synth-promo-audio.mjs && remotion ffmpeg -hide_banner -loglevel error -y -i public/ad/promo-raw.wav -af loudnorm=I=-14:TP=-1.5:LRA=11 -ar 48000 public/ad/promo-audio.wav",
    "promo:stills": "node scripts/promo-stills.mjs",
    "promo:render": "remotion render Promo-15s out/astral-promo-15s-9x16.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=320k --pixel-format=yuv420p",
    "reel:scan": "node scripts/reel/scan.mjs",
    "reel:transcribe": "node --no-warnings scripts/reel/transcribe.mjs",
    "reel:cut": "node --no-warnings scripts/reel/cut.mjs",
    "reel:probe": "node --no-warnings scripts/reel/probe.mjs",
    "reel:check": "node --no-warnings scripts/reel/check.mjs",
    "reel:sfx": "node --no-warnings scripts/reel/synth.mjs",
    "reel:mix": "node --no-warnings scripts/reel/mix.mjs",
    "reel:stills": "node --no-warnings scripts/reel/stills.mjs",
    "reel:render": "node --no-warnings scripts/reel/render.mjs",
    "reel:verify": "node --no-warnings scripts/reel/verify.mjs",
    "promo60:audio": "npm run reel:sfx -- src/ad60 && npm run reel:mix -- src/ad60",
    "promo60:check": "npm run reel:check -- src/ad60",
    "promo60:stills": "npm run reel:stills -- src/ad60",
    "promo60:render": "npm run reel:render -- src/ad60",
    "promo60:verify": "npm run reel:verify -- src/ad60",
    "promotn:audio": "npm run reel:sfx -- src/adtn && npm run reel:mix -- src/adtn",
    "promotn:check": "npm run reel:check -- src/adtn",
    "promotn:stills": "npm run reel:stills -- src/adtn",
    "promotn:render": "npm run reel:render -- src/adtn",
    "promotn:verify": "npm run reel:verify -- src/adtn"
  },
  "sideEffects": [
    "*.css"
  ]
}
