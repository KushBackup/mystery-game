rules_version = '2';

// Open rules suitable for an unauthenticated party-game lobby.
// The game runs on a private invite link with no Firebase Auth — the host is
// the trust boundary, not the database. Anyone who can load the app can write.
//
// Collections used by the app (see src/firebase/config.js):
//   gameState/current      - round, round clock, voting flags, unlocked files, revealed clues
//   gameState/votes        - per-player vote records and aggregate counts
//   gameState/playerData   - per-player unlocked clue list
//   messages/{id}          - chat messages
service cloud.firestore {
  match /databases/{database}/documents {
    match /gameState/{docId} {
      allow read, write: if true;
    }

    // Delete is open because the host has to be able to wipe the channel
    // between games. It used to be `delete: if false`, which meant the Host
    // Panel's Reset Game silently failed on the chat — clearAllMessages()
    // swallows its own error, so the host saw a clean reset while every player
    // still had the previous game's thread in front of them.
    // Update stays closed: nobody edits a message once it is sent.
    match /messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
      allow update: if false;
    }
  }
}
